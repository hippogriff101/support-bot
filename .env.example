SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Everything below is optional, and can be changed live by an admin from the
# bot's Home tab (Settings) — a value saved there wins over this file.
SUPPORT_CHANNEL_ID=C0123456789
EVENT_NAME=My Event

# Days a user can wait without a helper reply before the nudge persona
# flags the ticket in the support channel. Decimals work (0.5 = 12 hours);
# 0 turns nudges off. Defaults to 2.
# STALE_DAYS=2
# NUDGE_NAME=Chopsticks
# An emoji shortcode or an image URL.
# NUDGE_ICON=:chopsticks:

# Seconds between two broadcast DMs, so a broadcast to a few hundred people
# doesn't trip Slack's per-channel rate limit. Defaults to 1.2 (~50/minute).
# BROADCAST_GAP_SECONDS=1.2

# Optional: relocate the SQLite ticket DB, e.g. onto a mounted persistent
# volume. Defaults to ./tickets.db.
# DB_PATH=/data/tickets.db

# Optional: seeds the first admin into helpers.json on startup if the roster
# is empty. Without it, claim admin from the bot's Home tab with the setup
# code printed in the logs instead — see README.
# INITIAL_ADMIN_ID=U0123ABCDEF
# INITIAL_ADMIN_ROLE=My Event Support
