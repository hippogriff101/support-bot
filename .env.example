SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
SUPPORT_CHANNEL_ID=C0123456789
EVENT_NAME=My Event

# Optional: relocate the SQLite ticket DB, e.g. onto a mounted persistent
# volume. Defaults to ./tickets.db.
# DB_PATH=/data/tickets.db

# Optional: seeds the first admin into helpers.json on startup if the roster
# is empty. Useful on hosts where you can't hand-edit helpers.json before
# the first run — see README. Everyone after that is added via /support
# promote, so these only need to be set for the first deploy.
# INITIAL_ADMIN_ID=U0123ABCDEF
# INITIAL_ADMIN_ROLE=My Event Support

# --- New-feature settings (all optional — nothing breaks without them) ---

# Hack Club AI (https://ai.hackclub.com): powers canvas ticket summaries and
# the "similar question" one-click suggested replies. Create a personal API
# key from your ai.hackclub.com dashboard and paste it here.
# HACK_CLUB_AI_API_KEY=

# Model used for summaries/suggestions. Default google/gemini-2.5-flash
# (fast + cheap); any model from https://ai.hackclub.com works.
# AI_MODEL=google/gemini-2.5-flash

# Pre-created private canvas for resolved-ticket summaries. If unset, the
# bot creates one (tabbed into the support channel) on first close.
# CANVAS_ID=F1234ABCD

# Display name used for the per-message helper identity
# "《Firstname》| <SUPPORT_TEAM_NAME> Support Team" shown to users.
# Defaults to EVENT_NAME.
# SUPPORT_TEAM_NAME=My Event
